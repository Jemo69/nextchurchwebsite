generator client {
     provider = "prisma-client-js"
     binaryTargets = ["native", "rhel-openssl-3.0.x"]
     output = "../some/generated/prisma"
     previewFeatures = ["driverAdapters"]
}
datasource db {
     provider = "sqlite"
     url = env("DATABASE_URL")
}
model Post {
     slug String @id
     title String
     content String
     Status Status
     createdAt DateTime @default(now())
}
model PrayerRequest {
     id Int @id @default(autoincrement())
     name String
     email String
     message String
}
model EmailContact{
     id Int @id @default(autoincrement())
     name String
     email String
     is_subscriber Boolean
}
model NewletterPost {
     id Int @id @default(autoincrement())
     title String
     status Status
     content String
     createdAt DateTime @default(now())
}
model Questions {
     id Int @id @default(autoincrement())
     question String
     createdAt DateTime @default(now())
}
model Aboutme {
    id Int @id @default(autoincrement())
    name String
    message String
}
enum Status {
     DRAFT
     PUBLISHED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
